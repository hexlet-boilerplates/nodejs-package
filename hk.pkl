amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

steps {
    ["lint"] {
        check = "make lint"
        fix = "make lint-fix"
    }
}

hooks {
    ["pre-push"] {
        steps {
            ["test"] {
                check = "make test"
            }
        }
    }
}
